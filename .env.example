# Copy this file to backend/.env and fill in the values. Never commit it or paste real values in chat.

# Neon pooled connection string (the host contains "-pooler")
DATABASE_URL=
# Neon direct connection string (no "-pooler"), used for migrations
DIRECT_URL=
# Neon direct connection string to a SECOND database named "test" (tests wipe it)
TEST_DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORT=4000
