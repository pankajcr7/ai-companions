{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "dev:test": "USE_TEST_DB=1 ALLOW_LOCAL_ENDPOINTS=true CHATGPT_LOCAL_LOGIN=false PORT=4100 BETTER_AUTH_URL=http://localhost:3100 FRONTEND_URL=http://localhost:3100 tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset:test": "tsx test/reset-db.ts",
    "postinstall": "prisma generate",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "7.10",
    "@prisma/client": "7.10",
    "better-auth": "1.7",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "7.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
